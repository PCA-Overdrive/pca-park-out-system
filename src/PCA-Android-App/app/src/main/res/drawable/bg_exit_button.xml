<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#10141C" />
            <stroke android:width="1dp" android:color="#222A36" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1F355A" />
            <stroke android:width="2dp" android:color="#76A9FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#111927" />
            <stroke android:width="1dp" android:color="#2E405C" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
