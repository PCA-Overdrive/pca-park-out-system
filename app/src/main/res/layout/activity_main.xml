<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070A">

    <!-- 로그인 화면 -->
    <LinearLayout
        android:id="@+id/loginLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PCA-APP"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBtStatusLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="블루투스 연결 대기 중"
            android:textSize="14sp"
            android:textColor="#9AA4B2"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/etUserId"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="아이디"
            android:textColor="#FFFFFF"
            android:textColorHint="#758195"
            android:singleLine="true"
            android:paddingHorizontal="18dp"
            android:background="@drawable/bg_input_dark"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="비밀번호"
            android:textColor="#FFFFFF"
            android:textColorHint="#758195"
            android:singleLine="true"
            android:inputType="textPassword"
            android:paddingHorizontal="18dp"
            android:background="@drawable/bg_input_dark"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="로그인"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_primary_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="더미 계정: admin / 1234"
            android:textSize="13sp"
            android:textColor="#758195"
            android:layout_marginTop="16dp" />

    </LinearLayout>

    <!-- 메인 제어 화면 -->
    <LinearLayout
        android:id="@+id/controlLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PCA-APP"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parking Control Assistant"
            android:textSize="13sp"
            android:textColor="#758195"
            android:layout_marginTop="1dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#1D2838" />

        <!-- 상태 카드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_status_panel"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="블루투스"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvBtStatusMain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="연결 대기 중"
                    android:textSize="12sp"
                    android:textColor="#B8C4D6"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#1D2838" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="최근 패킷"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvLastPacket"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="없음"
                    android:textSize="12sp"
                    android:textColor="#9AA4B2"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="출차 방향 선택"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="차량이 빠져나갈 방향을 이미지로 확인하고 선택하세요."
            android:textSize="13sp"
            android:textColor="#9AA4B2"
            android:layout_marginBottom="10dp" />

        <!-- 출차 버튼 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 좌측 / 우측 출차 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- 좌측 출차 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnLeftExit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="#111827"
                    app:strokeWidth="1dp"
                    app:strokeColor="#263449"
                    app:rippleColor="#334155"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:src="@drawable/exit_left_car"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="false"
                            android:contentDescription="좌측 출차 이미지"
                            app:shapeAppearanceOverlay="@style/TopRoundedImage" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="좌측 출차"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 우측 출차 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnRightExit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="18dp"
                    app:cardBackgroundColor="#111827"
                    app:strokeWidth="1dp"
                    app:strokeColor="#263449"
                    app:rippleColor="#334155"
                    app:cardUseCompatPadding="false"
                    app:cardPreventCornerOverlap="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:src="@drawable/exit_right_car"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="false"
                            android:contentDescription="우측 출차 이미지"
                            app:shapeAppearanceOverlay="@style/TopRoundedImage" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="우측 출차"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 전진 출차 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnStraightExit"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#111827"
                app:strokeWidth="1dp"
                app:strokeColor="#263449"
                app:rippleColor="#334155"
                app:cardUseCompatPadding="false"
                app:cardPreventCornerOverlap="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:src="@drawable/exit_straight_car"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="false"
                        android:contentDescription="전진 출차 이미지"
                        app:shapeAppearanceOverlay="@style/TopRoundedImage" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="전진 출차"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <Button
            android:id="@+id/btnCancelExit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="출차 취소"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_cancel_button" />

    </LinearLayout>

</FrameLayout>